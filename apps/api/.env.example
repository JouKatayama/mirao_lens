SUPABASE_PUBLISHABLE_KEY=
# Legacy hosted projects may use an anon key instead.
SUPABASE_ANON_KEY=
# Required for cross-user cleanup sweep (POST /api/internal/cleanup-expired-scans).
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
AI_PERSONAL_CONTEXT_MODEL=
AI_CARD_EXTRACTION_MODEL=
AI_COMPANY_CONTEXT_MODEL=
AI_FLASH_BRIEF_MODEL=
AI_MUTUAL_VALUE_MODEL=

# Secret header value for the internal cleanup endpoint.
CLEANUP_SECRET=
