{
  "expo": {
    "name": "Miraio Lens",
    "slug": "miraio-lens",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "miraio-lens",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "名刺の写真を選択するために写真ライブラリを使用します。",
          "cameraPermission": "名刺を撮影するためにカメラを使用します。",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false,
          "cameraPermission": "名刺を撮影するためにカメラを使用します。",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
