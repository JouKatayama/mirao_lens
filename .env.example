# Values prefixed with EXPO_PUBLIC_ are embedded in the client bundle.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Public Supabase Auth/Data API configuration. These values are embedded in the
# mobile bundle and must never be replaced with a service-role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy hosted projects may still expose an anon key instead.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (PostHog). Leave blank to disable; analytics are non-fatal when absent.
EXPO_PUBLIC_POSTHOG_API_KEY=
# Optional: override the PostHog ingest host (defaults to https://us.i.posthog.com).
EXPO_PUBLIC_POSTHOG_HOST=
# Optional, development only. Set to 1 together with __DEV__ to expose the
# synthetic screen gallery at /ui-preview.
EXPO_PUBLIC_ENABLE_UI_PREVIEW=

# Server-only values for the API/BFF. Never expose these to the mobile app.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Model ids are configuration, not domain logic. Every current GPT-5.6/GPT-6
# model supports the Responses API, image input, strict structured output and
# the web_search tool, so a stage can be moved without touching code.
# Measured starting point (see docs/live-provider-smoke.md):
#   extraction  gpt-5.6-terra   image tokens dominate cost here
#   flash brief gpt-5.6-terra   on the 5-second path
#   company     gpt-5.6-terra   needs reliable tool calls when research is on
#   mutual      gpt-5.6-sol     async, quality over latency
#   onboarding  gpt-5.6-sol     once per user, sets up everything after it
AI_PERSONAL_CONTEXT_MODEL=
AI_CARD_EXTRACTION_MODEL=
AI_COMPANY_CONTEXT_MODEL=
AI_FLASH_BRIEF_MODEL=
AI_MUTUAL_VALUE_MODEL=
# Semantic retrieval of Personal Context (product spec 5.4). Set an embedding
# model to send the Flash Brief the items that relate to the person on the card
# instead of the whole profile. Blank keeps the previous behaviour: every
# approved item, no embedding calls, no cost. Changing the model afterwards
# requires the stored vectors to be regenerated, because a vector from one
# model means nothing against a vector from another.
AI_EMBEDDING_MODEL=

# Reasoning depth per stage: none, low, medium, high, xhigh or max. Blank omits
# the parameter, which is what a non-reasoning model or a self-hosted server
# needs. "minimal" is rejected: the GPT-5.6 models answer it with a 400.
# The timeouts in packages/ai/src/provider-client.ts were sized against a
# non-reasoning model, so the latency-critical stages want a low ceiling.
AI_PERSONAL_CONTEXT_EFFORT=
AI_CARD_EXTRACTION_EFFORT=
AI_COMPANY_CONTEXT_EFFORT=
AI_FLASH_BRIEF_EFFORT=
AI_MUTUAL_VALUE_EFFORT=

# Optional company web research. "on" lets the Company Context stage read public
# pages about the company through the provider's search tool and record them as
# Evidence with source URLs. Anything other than "on"/"off"/blank, or combining
# it with AI_PROVIDER_BASE_URL, is a startup error rather than a silent
# downgrade. It bills per scan, so it is off by default.
AI_COMPANY_WEB_SEARCH=

# Optional. Points every AI stage at an OpenAI-compatible server instead of
# OpenAI — a locally served model, for example (vLLM implements /v1/responses,
# Ollama since v0.13.3). Leave blank to use OpenAI. A malformed value is a
# startup error rather than a silent fallback.
AI_PROVIDER_BASE_URL=

# Secret header value for the internal cleanup endpoint
# (POST /api/internal/cleanup-expired-scans). The scheduled sweep in
# .github/workflows/cleanup-expired-scans.yml sends it as x-cleanup-secret.
CLEANUP_SECRET=

# Background jobs (future)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Prefer the app-specific templates in apps/mobile and apps/api. Real .env*
# files are gitignored and must never be committed.
